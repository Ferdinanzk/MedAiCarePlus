__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.venv/
venv/
env/

# Environment / secrets
.env
.env.*
*.env
!.env.example
!frontend_source/.env.example
face_token*.txt

# Docker volumes (local data, not code)
pgdata/
ollama_models/

# OS
.DS_Store
Thumbs.db
*.png

# IDE
.vscode/
.idea/
*.swp

# Logs
*.log

# Node
node_modules/

# Claude Code local settings
.claude/

# Test / debug artifacts
.playwright-mcp/
.graphify_python
RESEARCH_*.md
DIAGNOSTIC_*.md
HANDOFF*.md
ONBOARDING.md
ELDERLY_FONT_ANALYSIS.md

# Built frontend (regenerated by npm run build)
static/web/

# Debug / test artifacts
bash.exe.stackdump
ocr-result*.json
ocr-browser-result.json
playwright-report/
playwright_test/
playwright_ui_audit/
test-results/
graphify-out/
ruvector.db
test_face.jpg
tmp_gen_token.py

# Enrolled face photos (personal biometric data — never commit; only .gitkeep is tracked)
models/face_recognition/face_gallery/*.jpg
models/face_recognition/face_gallery/*.png
models/face_recognition/face_gallery/*.jpeg

# Model files — OpenVINO public downloads and other large binaries
*.task
*.onnx
*.bin
*.ckpt
# *.pt and *.pth inside models/ are tracked via Git LFS (see .gitattributes)
# *.pt and *.pth outside models/ are ignored
*.pt
*.pth
!models/segmentation/*.pt
!models/emotion/*.pth

# *.bin and *.xml inside models/face_recognition/ are tracked via Git LFS
# *.bin outside models/ stays ignored (large public downloads)
!models/face_recognition/**/*.bin
!models/face_recognition/**/*.xml

# Enrolled face images / test identities (PII — never commit). Keep folder only.
models/face_recognition/face_gallery/*
!models/face_recognition/face_gallery/.gitkeep

# Session planning + benchmark/experiment artifacts (not source code)
.hermes/
attachments/
confusion_results*.json
