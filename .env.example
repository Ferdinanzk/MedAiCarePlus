# Copy this file to .env and fill in your values
# Never commit .env — it is gitignored

# --- Database ---
DATABASE_URL=postgresql://medai:medai@localhost:5432/medaicare

# --- Ollama (local LLM for OCR) ---
OLLAMA_URL=http://host.docker.internal:11434/api/generate

# --- Auth ---
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-random-32-char-secret-key-here

# --- Supabase ---
SUPABASE_URL=https://your-project-id.supabase.co
# Found in: Supabase Dashboard → Project Settings → API → JWT Secret
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# --- Frontend ---
FRONTEND_URL=http://localhost:8000

# --- LINE Messaging API ---
# Found in: LINE Developers Console → your channel → Messaging API → Channel access token
LINE_CHANNEL_ACCESS_TOKEN=

# --- ngrok (optional, for LINE webhook on local dev) ---
NGROK_AUTHTOKEN=

# --- ML Model paths (inside Docker container — leave as-is if using docker-compose.dev.yml) ---
FACE_REC_BASE=/models/face_recognition
EMOTION_MODEL_PATH=/models/emotion/model4.2.2.pth
YOLO_MODEL_PATH=/models/segmentation/prescription_best_100_epo.pt
