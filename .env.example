# Copy this file to .env and fill in your values
# Never commit .env — it is gitignored

# --- Database ---
# docker compose supplies the service URL automatically. Keep this value for
# running the API directly on the host.
DATABASE_URL=postgresql://medai:medai@localhost:5432/medcareai2

# --- Auth ---
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-random-32-char-secret-key-here

# --- Supabase ---
SUPABASE_URL=https://your-project-id.supabase.co
# Found in: Supabase Dashboard → Project Settings → API → JWT Secret
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# --- Frontend ---
# Published app port; 8080 leaves host port 8000 available for Reachy Mini.
WEB_PORT=8080
# Public browser origin used for redirects/CORS. If WEB_PORT changes, update this too.
MEDCARE_FRONTEND_URL=http://localhost:8080

# --- LINE Messaging API ---
# Found in: LINE Developers Console → your channel → Messaging API → Channel access token
LINE_CHANNEL_ACCESS_TOKEN=
# Found in: LINE Developers Console → your channel → Basic settings → Channel secret
LINE_CHANNEL_SECRET=

# --- ngrok (optional, for LINE webhook on local dev) ---
NGROK_AUTHTOKEN=

# --- ML model paths (inside the production Docker image) ---
FACE_REC_BASE=/models/face_recognition
EMOTION_MODEL_PATH=/models/emotion_seed43/model_fp32.onnx

# --- Deployment and published legal notice ---
# dev logs configuration warnings; prod refuses unsafe/incomplete configuration.
# LINE_CHANNEL_SECRET above is mandatory for webhooks in both modes.
APP_ENV=dev
TERMS_VERSION=2026-10
OPERATOR_NAME=
OPERATOR_CONTACT=
TUNNEL_PROVIDER=

# Required when the optional Reachy feature is enabled (1/true/yes).
REACHY_FEATURE_ENABLED=0
# Optional Docker Compose Reachy bridge settings. Not needed when medcare_reachy is installed on the robot.
# REACHY_ROBOT_HOST=
# REACHY_DEVICE_TOKEN=
# Conversation text path for the robot notice: robot → LLM_SERVICE (router) → LLM_PROVIDER (model company).
LLM_SERVICE=OpenRouter
LLM_PROVIDER=
LLM_PROVIDER_REGION=
LLM_RETENTION=
# Server-side only; never put this on the robot or in frontend_source. LLM_MODEL is an OpenRouter model id.
OPENROUTER_API_KEY=
LLM_MODEL=google/gemini-2.5-flash-lite
# OpenRouter lists Gemini 2.5 Flash Lite as going away on 2026-10-20; choose a replacement before then.
# Tried when LLM_MODEL fails, is rate-limited (429), times out or answers nothing usable.
# With REACHY_FEATURE_ENABLED, LLM_MODEL and LLM_FALLBACK_MODEL must both be pinned (startup check): both get the
# memory notes, and the memory notice names the provider.
LLM_FALLBACK_MODEL=google/gemini-2.5-flash
# Most seconds a check-in reply may take (both models together) before Reachy says a fixed line instead. Default 8.
LLM_DEADLINE_SECONDS=8
# Reachy's check-in replies know the date, time, holidays and today's weather. The weather comes from Open-Meteo
# (no key), fetched every 30 minutes for this place. Only these coordinates are sent: use a town's, not the
# patient's address. WEATHER_PLACE only names it in the logs; the language model never gets it.
# WEATHER_ENABLED=false or an empty coordinate turns the weather off.
WEATHER_ENABLED=true
WEATHER_PLACE=台北
WEATHER_LATITUDE=25.0330
WEATHER_LONGITUDE=121.5654
# Optional provider routing (memory notices must be able to name the provider): comma-separated provider slugs,
# and "deny" to refuse providers that may store data.
# Routing applies to every call (reply, risk check, summary, memory) and to both models: with OPENROUTER_PROVIDER_ONLY
# set, LLM_MODEL and LLM_FALLBACK_MODEL must both be served by those providers.
OPENROUTER_PROVIDER_ONLY=
OPENROUTER_DATA_COLLECTION=
RISK_CLASSIFIER_API_KEY=

# --- Prescription OCR (the Scan page) ---
# OCR needs only your own Gemini API key here (https://aistudio.google.com/apikey). It is a secret: keep it in .env,
# never commit it. With it set, /health shows "ocr": true and scanning works for every account on this server.
# Without it, OCR falls back to a local Ollama vision model if one is running (OLLAMA_URL), else it is off.
GEMINI_API_KEY=
# The models below are the code defaults. gemini-3.8-flash, the default until 4 Oct 2026, answered 503 "high demand"
# on every scan on 3-4 Oct 2026; if an older .env still names it, change it or delete the line.
# gemini-3.5-flash read a real pharmacy receipt more accurately than gemini-3.5-flash-lite (docs/OCR.md), in 7-12 s.
OCR_MODEL=gemini-3.5-flash
# Tried once when OCR_MODEL is busy (429/5xx), times out or no longer exists (404). Empty turns the fallback off.
OCR_GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# Seconds per Gemini request, and for the whole scan (both models together).
OCR_GEMINI_TIMEOUT=25
OCR_GEMINI_IMAGE_BUDGET=45

# How many minutes before its scheduled time a dose may be started (Reachy reminder, camera session) or recorded as
# taken (camera, family confirmation, manual tap, "I've finished"). Earlier, the server refuses with 409
# dose_not_due_yet. Doses of one medicine closer than twice this are due from halfway between them instead
# (20:00 and 22:00: the 22:00 dose from 21:00). Skipping a later dose is always allowed. Default 120.
# This is one rule of overdose protection (minimum gap, daily maximum, missed doses expire), which each patient
# switches in Settings (on by default; no environment variable). The other limits are set per medicine.
DOSE_EARLY_MINUTES=120

# Keep this host-mounted ledger outside backup rotation; required for restore.
DELETION_LEDGER_FILE=/ledger/deletion_ledger.jsonl
# Strong passphrase for Sunday AES256 backups; store separately from backups.
# Nightly backups remain local, with 14 copies; encrypted weekly copies keep 4.
BACKUP_PASSPHRASE=

# Robot device API bind address (docker-compose). Default 127.0.0.1; set to this laptop's LAN IP so a Reachy Mini app can reach it.
DEVICE_BIND=127.0.0.1
